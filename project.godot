; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cloud Glider"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

P="*res://scripts/params.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/screen_space_aa=1

[shader_globals]

g_sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
g_moon_dir={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
g_light_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
g_light_col={
"type": "vec3",
"value": Vector3(5, 5, 5)
}
g_sun_col={
"type": "vec3",
"value": Vector3(5, 5, 5)
}
g_zenith={
"type": "vec3",
"value": Vector3(0.1, 0.2, 0.6)
}
g_horizon={
"type": "vec3",
"value": Vector3(0.5, 0.6, 0.9)
}
g_amb_top={
"type": "vec3",
"value": Vector3(0.3, 0.4, 0.6)
}
g_amb_bot={
"type": "vec3",
"value": Vector3(0.2, 0.2, 0.3)
}
g_night={
"type": "float",
"value": 0.0
}
g_overcast={
"type": "float",
"value": 0.0
}
g_haze={
"type": "float",
"value": 30000.0
}
g_wind={
"type": "vec2",
"value": Vector2(0, 0)
}
